# ============================================================
# n8n public URL
# ------------------------------------------------------------
# 【今の方針】まずはこのMac上のDocker Desktopでローカル起動して試す。
# 下の3行はローカル用のデフォルト値。VPSへ移す時だけ書き換える。
# ============================================================
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_PORT=5678

# --- VPSへ移行する時はこちらに差し替える（コメントアウトを外す） ---
# N8N_HOST=n8n.example.com
# N8N_PROTOCOL=https
# WEBHOOK_URL=https://n8n.example.com/

# ============================================================
# PostgreSQL
# ============================================================
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=n8n

# ============================================================
# n8n encryption key
# 32文字以上のランダム文字列を推奨。生成コマンド:
#   openssl rand -hex 32
# 一度決めたら変更しないこと（変更すると既存credentialsが復号できなくなる）。
# ============================================================
N8N_ENCRYPTION_KEY=change_me_very_long_random_string

# 実行データの保持方針（README参照）。ローカル検証中はallのままでOK。
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
EXECUTIONS_DATA_MAX_AGE=168

# ============================================================
# AI APIs
# ------------------------------------------------------------
# career-uranai.site本体（Vercel）とは別のAnthropicキーを発行して使うことを推奨。
# 理由: n8n側が万一漏洩・侵害された場合でも、本番サイトのキーとは独立して
# 無効化・ローテーションできるようにするため（影響範囲を分離する）。
# ============================================================
ANTHROPIC_API_KEY=

# ============================================================
# career-uranai.site 連携（Workflow 04: 承認後投稿/公開 で使用）
# ------------------------------------------------------------
# SEO記事は Google Sheets / Notion を経由せず、既存のCMS APIへ直接POSTする。
# API仕様: unified_fortuneTelling/docs/n8n-integration.md 参照
# N8N_API_KEYの値はVercel本番環境変数に設定済みのものを共有してもらって入力する。
# ============================================================
CAREER_SITE_BASE_URL=https://career-uranai.site
CAREER_SITE_N8N_API_KEY=

# ============================================================
# Content sources（Workflow 01: 情報収集で使用）
# ------------------------------------------------------------
# ニュース収集はRSS（無料・認証不要）で行うためAPIキー不要。
# ============================================================

# ============================================================
# 競合記事リサーチ（Workflow 03）: Gemini API（Google検索グラウンディング）
# 取得先: https://aistudio.google.com/apikey
# n8n側は「Header Auth」credential（ヘッダ名: x-goog-api-key）として登録する。
# ============================================================
GEMINI_API_KEY=

# ============================================================
# 記事内画像の自動生成（Workflow 03）: OpenAI API（gpt-image-2）
# 取得先: https://platform.openai.com/api-keys
# n8n側は「Header Auth」credential（ヘッダ名: Authorization、値: "Bearer sk-..."）として登録する。
# ============================================================
OPENAI_API_KEY=

# ============================================================
# SNS投稿案（Workflow 02）の下書き・承認先: Notion
# ------------------------------------------------------------
# 既存サイトが診断結果の保存に使っているNotion統合を流用する。
# ただし「SNS投稿案」専用の新しいデータベースをNotion上に作成し、
# そのデータベースIDをここに設定する（診断結果DBとは混在させない）。
# ============================================================
NOTION_API_KEY=
NOTION_SNS_DRAFTS_DATABASE_ID=

# ============================================================
# SNS APIs - 人間承認後の投稿フェーズで使用
# ------------------------------------------------------------
# X(旧Twitter): .envではなくn8n側の「X OAuth API」credential(OAuth1.0a)で管理する
# (2026-07-08設定済み。credential名: "X OAuth account"。Consumer Key/Secretは
# X Developer PortalのApp→Keys and tokensで発行したAPI Key/API Key Secretを使用、
# アクセストークンはn8nの「Connect my account」ボタンで@reiko_career1として認証済み)。
# 画像投稿にはOAuth2よりOAuth1.0a経由(旧v1.1 media/upload)の方が安定するためこちらを採用。
# Instagram/LINEは未着手。
# ============================================================
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
LINE_CHANNEL_ACCESS_TOKEN=

# ============================================================
# Discord画像レビューBot（automation/discord-bot/）
# ------------------------------------------------------------
# Workflow 03の画像品質チェックでNGが出た際に、Discordへ画像とエラー内容を送り、
# 🍓(承認)/🍇(修正指示して再生成)/🍋(やり直し)のリアクションで人間が判定するためのbot。
# このdocker-compose.ymlと同じディレクトリの.envに書く必要がある
# （discord-botのサービス定義もautomation/n8n/docker-compose.ymlにまとめているため）。
# 取得先・手順: automation/discord-bot/README.md 参照
# ============================================================
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
# カンマ区切りのDiscordユーザーID(数値)。レビュー依頼時にメンションしたい人を指定する(任意)。
MENTION_USER_IDS=
