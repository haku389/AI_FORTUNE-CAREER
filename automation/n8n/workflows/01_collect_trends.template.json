      "parameters": {
        "jsCode": "// トピック/感情/スコアの簡易ラベリング（プレースホルダー実装）\n// 実際はLLM呼び出し or ルールベース分類に差し替える\nfor (const item of $input.all()) {\n  const text = `${item.json.title ?? ''} ${item.json.snippet ?? ''}`;\n  item.json.topic_cluster = 'unclassified';\n  item.json.emotion_label = 'unclassified';\n  item.json.pain_label = 'unclassified';\n  item.json.intent_label = 'unclassified';\n  item.json.virality_score = 0;\n  item.json.seo_score = 0;\n  item.json.memo = 'placeholder scoring - see docs/workflow-design.md §6';\n}\nreturn $input.all();"
      },
